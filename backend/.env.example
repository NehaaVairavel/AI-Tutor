PORT=5000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Option A: Local MongoDB (development — requires mongod running locally)
# MONGODB_URI=mongodb://localhost:27017/ai-tutor

# Option B: MongoDB Atlas (production / when port 27017 is reachable outbound)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@cluster0.zgx7uul.mongodb.net/ai-tutor?retryWrites=true&w=majority&appName=Cluster0

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a long (64+ char), random string in production
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Supported providers: openai | google | anthropic
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
